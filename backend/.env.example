# AgriTwin backend — environment variables
# Copy this file to .env and fill in real values before running uvicorn.
# Never commit .env to version control.

# IBM watsonx.ai credentials
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Google Maps Geocoding API (required for universal location search)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Agmarknet commodity price API (optional — mock fallback used if absent)
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# Gemini ChatBot
GEMINI_API_KEY=your_gemini_api_key_here

# Backend server port (default: 8000)
PORT=8000
