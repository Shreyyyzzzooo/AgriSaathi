# AgriTwin — environment variables
# Copy this file to .env and fill in real values before running the backend.
# Never commit .env to version control.

# IBM watsonx.ai credentials
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Agmarknet commodity price API (optional — mock fallback used if absent)
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# Backend server port (default: 8000)
PORT=8000
